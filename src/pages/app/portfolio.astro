---
import App from "../../layouts/App.astro";
import ConfirmDialog from "../../components/app/ConfirmDialog.astro";
import { icon } from "../../lib/ui/icons";
import { ROUTES } from "../../lib/ui/paths";
---

<App title="Portfolio" current="portfolio">
  <div data-portfolio class="mx-auto max-w-[1440px] px-4 pb-20 lg:px-6">
    <div class="flex flex-wrap items-end justify-between gap-6 pt-8 pb-6">
      <div>
        <h1 class="text-[clamp(2rem,3.4vw,3rem)] leading-none font-black tracking-[-0.02em] wide">Portfolio</h1>
        <p class="mt-3 text-ink-2" data-summary aria-live="polite"></p>
      </div>
      <div class="flex flex-wrap items-center gap-2" data-toolbar hidden>
        <div class="inline-flex border border-ink p-0.5 text-sm font-bold" role="group" aria-label="View">
          <button type="button" data-mode="shelf" aria-pressed="true" class="inline-flex h-8 items-center gap-1.5 px-3 aria-pressed:bg-ink aria-pressed:text-white">
            <Fragment set:html={icon("shelf")} />Shelf
          </button>
          <button type="button" data-mode="table" aria-pressed="false" class="inline-flex h-8 items-center gap-1.5 px-3 aria-pressed:bg-ink aria-pressed:text-white">
            <Fragment set:html={icon("layers")} />Table
          </button>
        </div>
        <a href={`${ROUTES.factory}?new=1`} class="inline-flex h-9 items-center gap-1.5 bg-ultra px-3 text-sm font-bold text-white no-underline hover:bg-ultra-deep">
          <Fragment set:html={icon("plus")} />New company
        </a>
        <button type="button" data-clear class="inline-flex h-9 items-center gap-1.5 px-3 text-sm font-bold text-ink-2 hover:bg-die hover:text-white">
          <Fragment set:html={icon("trash")} />Clear portfolio
        </button>
      </div>
    </div>

    <div data-content></div>

    <div data-empty hidden class="mt-6 grid place-items-center border border-dashed border-ink/40 px-6 py-20 text-center">
      <svg viewBox="0 0 120 70" class="h-20 w-auto text-ink/30" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="4 3" aria-hidden="true">
        <path d="M10 66h100M22 66V26h26v40M52 66V14h30v52M86 66V36h20v30"></path>
      </svg>
      <h2 class="mt-6 text-2xl font-extrabold semiwide">The shelf is empty.</h2>
      <p class="mt-2 max-w-[44ch] text-ink-2">Companies you manufacture appear here, with their valuation, stage, and price.</p>
      <a href={`${ROUTES.factory}?new=1`} class="mt-6 inline-flex h-11 items-center gap-2 bg-ultra px-5 font-bold text-white no-underline hover:bg-ultra-deep">
        <Fragment set:html={icon("carton", "size-5")} />Manufacture a company
      </a>
    </div>
  </div>

  <ConfirmDialog />
</App>

<script>
  import "../../scripts/portfolio";
</script>
