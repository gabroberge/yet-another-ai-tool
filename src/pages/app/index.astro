---
import App from "../../layouts/App.astro";
import ConfirmDialog from "../../components/app/ConfirmDialog.astro";
import Catalog from "../../components/app/Catalog.astro";
import { icon } from "../../lib/ui/icons";

const TABS = [
  { id: "build", label: "Build", icon: "build" },
  { id: "architecture", label: "Architecture", icon: "layers" },
  { id: "artifacts", label: "Artifacts", icon: "doc" },
  { id: "console", label: "Console", icon: "terminal" },
  { id: "contents", label: "Contents", icon: "carton" },
  { id: "history", label: "History", icon: "history" },
] as const;
---

<App title="Factory" current="factory">
  <div data-factory class="mx-auto max-w-[1440px] px-4 lg:px-6">
    <div data-strip class="border-b border-rule"></div>

    <Catalog />

    <section data-view="venture" hidden class="pb-20">
      <div data-venture-head class="py-6"></div>
      <div class="grid gap-8 lg:grid-cols-[minmax(320px,0.78fr)_minmax(0,1.6fr)] lg:gap-10">
        <aside class="self-start lg:sticky lg:top-[4.5rem]" aria-label="Package">
          <div class="relative flex min-h-[380px] items-end justify-center bg-[#e1e3e9] px-4 pt-8">
            <div data-stage-carton class="flex items-end justify-center"></div>
          </div>
          <div class="h-3 bg-ink" aria-hidden="true"></div>
          <div class="bg-[#d9dce3] p-3">
            <div data-stage-label></div>
          </div>
          <div data-stage-metrics class="mt-3"></div>
        </aside>

        <div class="min-w-0">
          <div role="tablist" aria-label="Company workspace" class="sticky top-14 z-10 -mx-4 flex overflow-x-auto [scrollbar-width:none] border-b border-ink bg-board px-4 lg:static lg:mx-0 lg:px-0">
            {
              TABS.map((t, i) => (
                <button
                  role="tab"
                  type="button"
                  id={`tab-${t.id}`}
                  data-tab={t.id}
                  aria-controls="tab-panel"
                  aria-selected={i === 0 ? "true" : "false"}
                  tabindex={i === 0 ? 0 : -1}
                  class="-mb-px flex h-11 shrink-0 items-center gap-1.5 border-b-[3px] border-transparent px-3 text-sm font-semibold text-ink-2 transition-colors hover:text-ink aria-selected:border-ultra aria-selected:text-ink"
                >
                  <Fragment set:html={icon(t.icon)} />
                  {t.label}
                </button>
              ))
            }
          </div>
          <div id="tab-panel" role="tabpanel" aria-labelledby="tab-build" tabindex="0" data-panel class="pt-6 focus:outline-none"></div>
        </div>
      </div>
    </section>

    <noscript><p class="py-20 text-center text-ink-2">The Factory needs JavaScript enabled.</p></noscript>
  </div>

  <ConfirmDialog />
</App>

<script>
  import "../../scripts/factory";
</script>
