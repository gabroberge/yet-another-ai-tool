---
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/marketing/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Hero from "../components/marketing/Hero.astro";
import Shelf from "../components/marketing/Shelf.astro";
import PackagingLine from "../components/marketing/PackagingLine.astro";
import Architecture from "../components/marketing/Architecture.astro";
import BackOfBox from "../components/marketing/BackOfBox.astro";
import Testimonials from "../components/marketing/Testimonials.astro";
import Pricing from "../components/marketing/Pricing.astro";
import Trust from "../components/marketing/Trust.astro";
import Faq from "../components/marketing/Faq.astro";
import ClosingCta from "../components/marketing/ClosingCta.astro";
---

<Base title="YAAT™ · Every capability deserves a company">
  <SiteHeader />
  <main id="main">
    <Hero />
    <Shelf />
    <PackagingLine />
    <Architecture />
    <BackOfBox />
    <Testimonials />
    <Pricing />
    <Trust />
    <Faq />
    <ClosingCta />
  </main>
  <SiteFooter />
</Base>
