---
import { KIND_LABELS, SUBSTRATES, SUBSTRATE_KINDS } from "../../lib/domain/substrates";
import { icon } from "../../lib/ui/icons";
import { latency } from "../../lib/format";
---

<section data-view="catalog" aria-labelledby="catalog-title" hidden class="pb-20">
  <div class="flex flex-wrap items-end justify-between gap-6 pt-6 pb-6">
    <div>
      <h1 id="catalog-title" class="text-[clamp(2rem,3.4vw,3rem)] leading-none font-black tracking-[-0.02em] wide">Choose a technology</h1>
      <p class="mt-3 max-w-[56ch] text-ink-2">Every company starts from something that already works. Pick one and YAAT manufactures the rest.</p>
    </div>
    <button type="button" data-action="random" data-key="random" class="inline-flex h-11 items-center gap-2 border-2 border-ink px-4 text-sm font-bold transition-colors hover:bg-ink hover:text-white">
      <Fragment set:html={icon("sparkle")} />
      Surprise me
    </button>
  </div>

  <div class="flex flex-wrap gap-1.5 border-y border-ink py-3" role="group" aria-label="Filter by type">
    <button type="button" data-filter="all" aria-pressed="true" class="h-8 border border-ink/20 px-3 text-[13px] font-semibold hover:border-ink aria-pressed:border-ink aria-pressed:bg-ink aria-pressed:text-white">
      All <span class="ml-1 opacity-60 tabular">{SUBSTRATES.length}</span>
    </button>
    {
      SUBSTRATE_KINDS.map((k) => (
        <button type="button" data-filter={k} aria-pressed="false" class="h-8 border border-ink/20 px-3 text-[13px] font-semibold hover:border-ink aria-pressed:border-ink aria-pressed:bg-ink aria-pressed:text-white">
          {KIND_LABELS[k].many} <span class="ml-1 opacity-60 tabular">{SUBSTRATES.filter((s) => s.kind === k).length}</span>
        </button>
      ))
    }
  </div>

  <ul class="grid gap-x-10 lg:grid-cols-2" aria-label="Technologies">
    {
      SUBSTRATES.map((s) => (
        <li data-kind={s.kind} class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-5 gap-y-2 border-b border-rule py-4">
          <div class="min-w-0">
            <p class="flex flex-wrap items-baseline gap-x-2.5">
              <span class="font-bold">{s.name}</span>
              <span class="narrow text-xs font-bold text-ink-3">{KIND_LABELS[s.kind].one}</span>
            </p>
            <p class="mt-0.5 text-sm text-ink-2">{s.does}</p>
            <code class="mt-2 block truncate font-mono text-xs text-ink-2">{s.footprint}</code>
          </div>
          <div class="flex flex-col items-end gap-1.5">
            <button
              type="button"
              data-action="manufacture"
              data-id={s.id}
              data-key={`manufacture-${s.id}`}
              class="inline-flex h-10 items-center gap-2 border-2 border-ink px-4 text-sm font-bold transition-colors hover:border-ultra hover:bg-ultra hover:text-white"
              aria-label={`Manufacture a company from ${s.name}`}
            >
              <Fragment set:html={icon("carton")} />
              Manufacture
            </button>
            <span class="text-[11px] text-ink-3 tabular">{latency(s.baseLatencyMs)}, since {s.firstReleased}</span>
          </div>
        </li>
      ))
    }
  </ul>
</section>
