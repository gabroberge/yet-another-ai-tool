<dialog data-confirm class="m-auto w-[min(26rem,calc(100%-2rem))] bg-paper p-0 text-ink shadow-carton backdrop:bg-ink/50">
  <form method="dialog" class="p-6">
    <h2 class="text-xl font-extrabold semiwide" data-confirm-title></h2>
    <p class="mt-2 text-sm text-ink-2" data-confirm-body></p>
    <div class="mt-6 flex justify-end gap-2">
      <button value="cancel" class="inline-flex h-10 items-center px-4 text-sm font-bold hover:bg-board">Cancel</button>
      <button value="confirm" class="inline-flex h-10 items-center bg-die px-4 text-sm font-bold text-white hover:bg-ink" data-confirm-ok></button>
    </div>
  </form>
</dialog>
