---
import Logo from "../Logo.astro";
import { ROUTES } from "../../lib/ui/paths";

const links = [
  { href: "#line", label: "How it works" },
  { href: "#shelf", label: "Customers" },
  { href: "#pricing", label: "Pricing" },
  { href: "#trust", label: "Trust" },
  { href: "#faq", label: "FAQ" },
];
---

<header class="relative z-20 border-b border-rule bg-board/90 backdrop-blur-[2px]">
  <nav aria-label="Primary" class="mx-auto flex h-16 max-w-[1320px] items-center gap-8 px-5 lg:px-8">
    <Logo href={ROUTES.home} />
    <ul class="hidden items-center gap-6 text-sm font-medium text-ink-2 md:flex">
      {
        links.map((l) => (
          <li>
            <a href={l.href} class="no-underline transition-colors hover:text-ink">
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="ml-auto flex items-center gap-3">
      <a href={ROUTES.portfolio} class="hidden text-sm font-medium text-ink-2 no-underline hover:text-ink sm:inline">Portfolio</a>
      <a
        href={ROUTES.factory}
        class="inline-flex h-10 items-center bg-ink px-4 text-sm font-bold text-white no-underline transition-colors hover:bg-ultra"
        >Open the Factory</a
      >
    </div>
  </nav>
</header>
