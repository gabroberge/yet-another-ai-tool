---
import { renderBarcode } from "../../lib/ui/barcode";
import { ROUTES } from "../../lib/ui/paths";

const TIERS = [
  {
    id: "prototype",
    name: "Prototype",
    monthly: "$0",
    annual: "$0",
    unit: "forever",
    blurb: "For validating a single capability.",
    includes: ["1 company", "Up to 2 agents", "Shelf label and Contents panel", "Launch announcement"],
  },
  {
    id: "seed",
    name: "Seed",
    monthly: "$49",
    annual: "$39",
    unit: "per month",
    blurb: "For founders with more than one idea.",
    includes: ["5 companies", "All agent and intelligence modules", "Agent skill file", "Console with inference trace"],
  },
  {
    id: "series",
    name: "Series",
    monthly: "$499",
    annual: "$399",
    unit: "per month",
    blurb: "For portfolios that report to a board.",
    includes: ["Unlimited companies", "Governance and trust modules", "Investor memo and Trust Center", "Portfolio telemetry"],
    featured: true,
  },
  {
    id: "leader",
    name: "Category Leader",
    monthly: "0.5%",
    annual: "0.4%",
    unit: "of valuation, per year",
    blurb: "For companies that define the category.",
    includes: ["Category creation", "Proprietary index methodology", "Enterprise deployment", "Named success architect"],
  },
];
---

<section id="pricing" aria-labelledby="pricing-title" class="scroll-mt-16 bg-paper py-20 lg:py-28" data-pricing>
  <div class="mx-auto max-w-[1320px] px-5 lg:px-8">
    <div class="flex flex-wrap items-end justify-between gap-8">
      <div>
        <h2 id="pricing-title" class="text-[clamp(2.25rem,4vw,3.75rem)] leading-[0.95] font-black tracking-[-0.025em] wide">Priced to move.</h2>
        <p class="mt-5 max-w-[48ch] text-lg leading-snug text-ink-2">Start free. Upgrade when your portfolio needs governance, or when the board does.</p>
      </div>
      <div class="inline-flex border-2 border-ink p-1 text-sm font-bold" role="group" aria-label="Billing period">
        <button type="button" data-billing="monthly" aria-pressed="true" class="h-9 px-4 aria-pressed:bg-ink aria-pressed:text-white">Monthly</button>
        <button type="button" data-billing="annual" aria-pressed="false" class="h-9 px-4 aria-pressed:bg-ink aria-pressed:text-white">Annual, save 20%</button>
      </div>
    </div>

    <div class="mt-14">
      <div class="h-4 bg-ink" aria-hidden="true"></div>
      <ul class="grid gap-x-4 gap-y-8 bg-[#d9dce3] px-4 pt-4 pb-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          TIERS.map((t) => (
            <li class:list={["relative flex flex-col bg-paper p-5 shadow-panel", t.featured && "outline-[3px] outline-ultra"]}>
              {t.featured && (
                <span class="absolute -top-3 right-4 grid size-16 rotate-[-8deg] place-items-center rounded-full border-2 border-ink bg-seal text-center text-[11px] leading-tight font-black">
                  Most
                  <br />
                  chosen
                </span>
              )}
              <div class="flex items-start justify-between gap-3">
                <h3 class="text-lg font-extrabold semiwide">{t.name}</h3>
                <Fragment set:html={renderBarcode(`YAAT-${t.id.toUpperCase()}`, "h-6 w-auto shrink-0 text-ink", false)} />
              </div>
              <p class="mt-1 min-h-10 text-sm text-ink-2">{t.blurb}</p>
              <p class="mt-5 border-t border-ink pt-3">
                <span class="text-5xl leading-none font-black tracking-tight tabular wide" data-price data-monthly={t.monthly} data-annual={t.annual}>
                  {t.monthly}
                </span>
                <span class="mt-1 block text-xs text-ink-2">{t.unit}</span>
              </p>
              <ul class="mt-6 flex-1 space-y-2 text-sm">
                {t.includes.map((x) => (
                  <li class="flex gap-2">
                    <svg viewBox="0 0 24 24" class="mt-0.5 size-4 shrink-0 text-ultra" fill="none" stroke="currentColor" stroke-width="2.25" aria-hidden="true">
                      <path d="m5 12.5 4.5 4.5L19 7.5" />
                    </svg>
                    {x}
                  </li>
                ))}
              </ul>
              <a
                  href={ROUTES.factory}
                  class:list={[
                    "mt-6 inline-flex h-11 items-center justify-center px-4 text-sm font-bold no-underline transition-colors",
                    t.featured ? "bg-ultra text-white hover:bg-ultra-deep" : "border-2 border-ink hover:bg-ink hover:text-white",
                  ]}
                >
                  {t.id === "leader" ? "Talk to sales" : "Start manufacturing"}
                </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<script>
  import { setFigure } from "../../lib/ui/motion";

  const root = document.querySelector<HTMLElement>("[data-pricing]")!;
  const buttons = root.querySelectorAll<HTMLButtonElement>("[data-billing]");
  buttons.forEach((b) =>
    b.addEventListener("click", () => {
      const period = b.dataset.billing as "monthly" | "annual";
      buttons.forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
      root.querySelectorAll<HTMLElement>("[data-price]").forEach((el) => setFigure(el, el.dataset[period]!));
    }),
  );
</script>
